# =============================================================================
# Enterprise AI IDS — environment configuration template
# =============================================================================
#
# Copy this file to `.env` and fill in the values:
#
#     cp env-example .env
#
# NEVER commit `.env` with real secrets. This `env-example` file is a template
# and is safe to commit. Generate secrets with:
#
#     python3 -c "import secrets; print(secrets.token_hex(32))"     # FLASK_SECRET
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))" # IDS_SENSOR_TOKEN
#
# Anything in <angle-brackets> is a placeholder that MUST be replaced.
# Optional features are marked (optional).
#
# -----------------------------------------------------------------------------

# =============================================================================
# Application / Web UI
# =============================================================================
# Flask session secret — required. Changing this invalidates all sessions.
FLASK_SECRET=<generate-with-secrets.token_hex(32)>

# "true" = HTTPS on port 5000 with an ad-hoc self-signed certificate (default)
# "false" = plain HTTP. Only use false behind a TLS-terminating reverse proxy.
WEB_UI_SSL=true

# If terminating TLS at a reverse proxy, set the number of trusted proxies so
# Flask honors X-Forwarded-* headers. 0 = directly exposed. (optional)
TRUSTED_PROXIES=0

# Custom TLS cert/key for the web UI. When both are set, they replace the
# ad-hoc certificate. (optional)
#SSL_CERT_FILE=/etc/ssl/private/ids.crt
#SSL_KEY_FILE=/etc/ssl/private/ids.key

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JSON log output (one JSON object per line). Useful for log shippers. (optional)
IDS_LOG_JSON=false

# Extra debug output (in addition to LOG_LEVEL). (optional)
IDS_DEBUG=false

# Log file directory and rotation. Defaults to <repo>/logs/. (optional)
#IDS_LOG_DIR=logs
#IDS_LOG_MAX_BYTES=10485760
#IDS_LOG_BACKUP_COUNT=5

# =============================================================================
# Rate limiting (optional, enterprise-tuned defaults)
# =============================================================================
# Default limits for unauthenticated requests. Loopback and authenticated
# sessions are exempted from these limits, but per-endpoint decorators
# (login, MFA, admin actions) still apply. Raise the ceiling for
# high-volume API consumers; lower it for stricter throttling of unknown
# sources. The dashboard's own polling (health every 5s, stats every 10s)
# is well under the default.
RATELIMIT_DEFAULT_HOURLY=5000
RATELIMIT_DEFAULT_DAILY=50000

# =============================================================================
# MySQL
# =============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=test_user
MYSQL_PASSWORD=change-me
MYSQL_DB=ids_db_test

# Bootstrap admin account — created only when the `users` table is empty.
IDS_BOOTSTRAP_ADMIN_USER=<admin-username>
IDS_BOOTSTRAP_ADMIN_PASSWORD=<admin-password>

# Connection pool tuning. Defaults are fine for a single-host deployment.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# SQLite training store (legacy, used by the retrainer as a fallback).
#DB_PATH=ids.db

# =============================================================================
# SMTP (alerts + email OTP) — optional
# =============================================================================
# SMTP is optional. It is only required if you use email alerts or
# email-based OTP. If unset, those features are silently disabled and
# the rest of the IDS runs normally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender@gmail.com>
SMTP_PASSWORD=<app-specific-password>
SMTP_FROM=<sender@gmail.com>

# Comma-separated list of alert recipients.
ALERT_RECIPIENTS=<recipient@example.com>

# =============================================================================
# IDS Sensor — packet capture
# =============================================================================
# Network interface to sniff. Common values: eth0, ens18, wlan0.
SNIFFER_INTERFACE=eth0

# BPF filter applied to the capture. "ip" captures all IPv4 traffic.
# Examples: "tcp or udp", "not port 22", "net 10.0.0.0/8"
SNIFFER_BPF=ip

# =============================================================================
# IDS Sensor — performance tuning (optional, sensible defaults)
# =============================================================================
# Analysis worker threads (default: CPU count, capped at 16)
IDS_WORKER_COUNT=8

# Feature-extraction threads between capture and analysis
# (default: min(4, CPU count); 0 = inline)
IDS_PREPROCESS_WORKERS=4

# Queue sizes. Larger = more burst tolerance, more memory.
IDS_QUEUE_MAXSIZE=50000
IDS_RAW_QUEUE_MAXSIZE=10000
IDS_LOG_QUEUE_MAXSIZE=50000

# Sharded locks for concurrent flow/behavior tracking. Higher = less contention.
IDS_FLOW_SHARDS=128
IDS_BEHAVIOR_SHARDS=64

# Idle flow eviction window (seconds). Flows silent for longer are dropped.
IDS_FLOW_IDLE_TIMEOUT_S=300

# Packet processing retry on transient handler errors.
IDS_PACKET_MAX_RETRIES=2

# Worker watchdog: a worker silent for longer than this is restarted.
IDS_WATCHDOG_INTERVAL=15
IDS_WORKER_STALL_SEC=120

# Sensor heartbeat file freshness (seconds). Web UI marks the sensor OFFLINE
# after this gap. Must be greater than IDS_HEARTBEAT_INTERVAL_SEC.
IDS_HEARTBEAT_STALE_SEC=30
IDS_HEARTBEAT_INTERVAL_SEC=5

# Under sustained queue pressure, drop 3 of every 4 packets to keep the
# workers from falling further behind.
IDS_PRESSURE_SAMPLE_AT=0.80

# Rate-limit "queue full" warnings to once per this many seconds.
IDS_DROP_LOG_INTERVAL=5

# =============================================================================
# IDS Sensor — detection thresholds
# =============================================================================
# Fusion thresholds for the final classification.
IDS_SUSPICIOUS_THRESHOLD=0.52
IDS_DANGEROUS_THRESHOLD=0.78

# Port-scan detection: distinct destination ports within a rolling window.
IDS_PORT_SCAN_THRESHOLD=25
IDS_PORT_SCAN_WINDOW=8

# Ports the IDS host itself exposes (comma-separated). Traffic to these
# ports is never flagged as "unusual_port" — you do not need the IDS to
# warn you about your own dashboard. Set this to whatever the Web UI and
# any other local services listen on. Example: IDS_SERVICE_PORTS=5000
IDS_SERVICE_PORTS=5000

# Flood detection: packets from one source within a rolling window.
IDS_FLOOD_THRESHOLD=120
IDS_FLOOD_WINDOW=3

# =============================================================================
# IDS Sensor — data persistence
# =============================================================================
# Persist "safe" events to packet_logs too. Off by default to save space.
IDS_PERSIST_SAFE_LOGS=false

# How often to flush the dashboard counters to MySQL (seconds).
IDS_STATS_PERSIST_INTERVAL=2

# Batch size and flush interval for the async DB writer.
IDS_DB_BATCH_SIZE=50
IDS_DB_FLUSH_INTERVAL=0.5

# Log retention (days). Older rows are pruned by the retention worker.
IDS_LOG_RETENTION_DAYS=7

# Training-sample collection (used by the retrainer).
IDS_TRAINING_ENABLED=true
# Fraction of "safe" events to keep as training samples (0.0 - 1.0).
IDS_TRAINING_SAFE_SAMPLE_RATE=0.02

# Threat-intel cache TTL (seconds) in the persistence layer.
IDS_TI_CACHE_TTL=3600

# =============================================================================
# Telemetry (sensor → web UI)
# =============================================================================
# Endpoint the sensor pushes stats to. Must point at the Web UI.
# If WEB_UI_SSL=true, use https://localhost:5000/ids
API_URL=https://localhost:5000/ids

# Shared HMAC secret used to sign every telemetry POST to /ids/update.
# Must be identical on both sides (ids_engine.py and uni-srver.py read it
# from the same .env). The secret is never transmitted on the wire — each
# request carries an HMAC-SHA256 signature over method/path/timestamp/nonce/
# SHA256(body), and the server verifies it in constant time. Replay is
# prevented by a nonce + timestamp window.
#
# Longer is better: generate with
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IDS_SENSOR_TOKEN=<generate-with-secrets.token_urlsafe(48)>

# Verify TLS certificates on the telemetry POST. Set to "false" when the
# Web UI uses the ad-hoc self-signed certificate.
IDS_TLS_VERIFY=false

# Seconds between telemetry pushes.
SEND_INTERVAL=5

# Startup delay + max wait for the Web UI to come up before giving up.
SENDER_STARTUP_DELAY=3
SENDER_MAX_WAIT=45

# Signed-request tolerances (seconds).
#   * MAX_SKEW_SEC      — server rejects any request whose timestamp is
#                         further than this from server time. 60s is safe
#                         for single-host deployments with NTP. Raise only
#                         if the sensor and web UI run on different hosts
#                         without synchronized clocks.
#   * NONCE_RETENTION_SEC — how long a nonce is remembered to detect replay.
#                         Must be at least MAX_SKEW_SEC; 300s is generous.
IDS_AUTH_MAX_SKEW_SEC=60
IDS_AUTH_NONCE_RETENTION_SEC=300

# =============================================================================
# TLS interception (SSL decryption) — optional
# =============================================================================
# Enable: SSL_DECRYPTION_ENABLED=true, then follow the "TLS Interception"
# section in README.md — it walks through sslsplit install, the sudoers
# rule, the root CA, and the iptables redirect.
# =============================================================================
# NGFW-style HTTPS decryption via sslsplit — a system package, not a
# Python dependency. Install with one of:
#     sudo dnf install sslsplit -y     # Fedora / RHEL
#     sudo apt install sslsplit        # Debian / Ubuntu
#
# Enabling this intercepts and terminates TLS. Only enable on networks you
# own or have explicit written authorization to monitor.
SSL_DECRYPTION_ENABLED=false

# Port the interceptor listens on. iptables redirects TCP/443 here.
SSL_INTERCEPT_PORT=8443

# Bind address for the interceptor.
SSL_INTERCEPT_HOST=0.0.0.0

# How often the interceptor reconciles iptables SNI bypass rules with the
# database. The web UI also triggers an immediate reconciliation on every
# rule change, so this is the maximum staleness for out-of-band edits.
SSL_BYPASS_SYNC_SEC=30

# =============================================================================
# Threat Intelligence
# =============================================================================
# Enable: set REPUTATION_KEY (AbuseIPDB) and/or VT_KEY (VirusTotal).
# Without either, only the local blocklist and ip-api.com are used.
# =============================================================================
# AbuseIPDB — https://www.abuseipdb.com/account/api
REPUTATION_KEY=<abuseipdb-api-key>
ABUSEIPDB_URL=https://api.abuseipdb.com/api/v2/check

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VT_KEY=<virustotal-api-key>
VIRUSTOTAL_URL=https://www.virustotal.com/api/v3/urls

# ip-api.com — free tier, no key. HTTP-only. Disable on untrusted networks.
IPAPI_ENABLED=true

# Local IP blocklist (one IP per line, # for comments).
TI_BLOCKLIST_PATH=config/blocklist_ips.txt

# In-memory reputation cache TTL.
TI_CACHE_TTL_SECONDS=3600

# Only run full TI lookups when the fused score crosses these.
TI_MIN_SCORE_FOR_LOOKUP=0.25
TI_FULL_ENRICH_SCORE=0.45

# =============================================================================
# Zeek correlation — optional
# =============================================================================
# Enable Zeek enrichment by pointing at a Zeek log directory or a specific
# conn.log. Leave unset to disable the feature entirely.
ZEEK_LOG=/opt/zeek/logs/current/conn.log
ZEEK_LOG_DIR=/opt/zeek/logs/current
ZEEK_NOTICE_LOG=/opt/zeek/logs/current/notice.log
ZEEK_WEIRD_LOG=/opt/zeek/logs/current/weird.log

# Zeek log polling interval (seconds) and per-IP cache TTL.
ZEEK_UPDATE_INTERVAL_SEC=5
ZEEK_CACHE_TTL_SECONDS=30
ZEEK_CACHE_IDLE_SEC=3600

# =============================================================================
# Email burst alerts — optional
# =============================================================================
# Enable: requires SMTP_* above and ALERT_RECIPIENTS to be set. Without
# both, alerts are silently skipped and the IDS runs normally.
#
# Two tiers are supported:
#   - Fast burst: many DANGEROUS events in the window. Default 10 events.
#   - Slow scan:  many suspicious-but-elevated events (risk >= SLOW_RISK)
#                 in the same window. Fires at a much higher count so
#                 ordinary noise does not trigger it. Catches slow
#                 intrusions that never cross the dangerous threshold.
#
# After an alert fires for a given IP, further alerts for the same IP are
# suppressed for DEDUP_SEC. A global limiter additionally caps how often
# any alert can be sent, so a distributed scan producing many source IPs
# cannot flood the mailbox.
IDS_BURST_ALERT_WINDOW_SEC=1200
IDS_BURST_ALERT_MIN_EVENTS=10
IDS_BURST_ALERT_DEDUP_SEC=600

# Slow-scan tier
IDS_BURST_ALERT_SLOW_RISK=0.45
IDS_BURST_ALERT_SLOW_MIN_EVENTS=50

# Minimum seconds between ANY two burst alert emails. Suppressed alerts
# are counted and reported in the next email that does go out.
IDS_BURST_ALERT_GLOBAL_DEDUP_SEC=30

# =============================================================================
# Runtime feature flags
# =============================================================================
# When running main.py (the supervisor), leave this false — the supervisor
# starts the sensor itself. Set to true only when running uni-srver.py
# standalone and you want the Web UI to spawn a sensor subprocess.
WEBUI_START_IDS_SENSOR=true

# Auto-restart the IDS engine when it exits unexpectedly.
# Off by default; the dashboard shows OFFLINE until you restart manually.
IDS_AUTO_RESTART=true
IDS_RESTART_COOLDOWN_SEC=30

# Skip the database bootstrap at startup (already-initialized deployments).
#IDS_SKIP_DB_BOOTSTRAP=false